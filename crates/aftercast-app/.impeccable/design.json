  "narrative": {
    "northStar": "The Encounter Workspace",
    "overview": "aftercast is a task-focused Windows desktop workspace. Its visual character comes from the official Catppuccin palette, readable system typography, and flat, divided work areas. Mocha is the default; Macchiato, Frappé, and Latte retain the same semantic roles and component geometry.\n\nThe interface gives most space to the current task while keeping ordered navigation, encounters, host actions, and status available around it. Korean and English use the same quiet typographic hierarchy. The existing Rust components and Tailwind v4 utilities define the system; this document captures that first implemented increment.",
    "keyCharacteristics": [
      "Official Catppuccin colours with a restrained mauve action accent.",
      "System fonts for English and Korean desktop reading.",
      "Flat surfaces divided by thin borders and tonal changes.",
      "Compact controls, spacious task content, and persistent status."
    ],
    "rules": [
      {
        "name": "The Flavour Binding Rule",
        "body": "Resolve colours through the current Catppuccin flavour; a new screen must change with the existing appearance selector.",
        "section": "colors"
      },
      {
        "name": "The Flat Workspace Rule",
        "body": "Use the existing tonal surfaces and borders to separate adjacent work areas.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** use the live Catppuccin semantic colours across all four flavours.",
      "**Do** reuse the Rust Button and Input components for matching controls.",
      "**Do** retain visible field labels, keyboard focus and explicit selected states.",
      "**Do** use tabular figures for result metrics and preserve readable table scrolling.",
      "**Do** verify Korean and English at the minimum desktop window size."
    ],
    "donts": [
      "**Don't** hard-code Mocha colours into a screen that supports flavour switching.",
      "**Don't** replace the system-font stack with a decorative display face.",
      "**Don't** add shadows or floating-card styling to the existing flat workspace.",
      "**Don't** use colour alone to identify the current page or selected encounter."
    ]
  }
}

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>Bxivact.Bridge</AssemblyName>
    <GenerateRuntimeConfigurationFiles>true</GenerateRuntimeConfigurationFiles>
    <RollForward>LatestPatch</RollForward>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../ActCompat/ActCompat.fsproj" />
    <Reference Include="System.Windows.Forms">
      <HintPath>$(PkgMicrosoft_NETFramework_ReferenceAssemblies_net48)/build/.NETFramework/v4.8/System.Windows.Forms.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3" GeneratePathProperty="true" PrivateAssets="all" ExcludeAssets="all" />
    <!-- Older plugin JSON serializers reference these legacy permission types during reflection. -->
    <PackageReference Include="System.Security.Permissions" Version="10.0.13" GeneratePathProperty="true" />
    <Compile Include="Platform.fs" />
    <Compile Include="PluginLoader.fs" />
    <Compile Include="PluginSession.fs" />
    <Compile Include="EntryPoint.fs" />
  </ItemGroup>
  <Target Name="PrepareCompatibilityPayload" AfterTargets="Publish">
    <!-- Cargo keeps a flat payload; preserve the Windows implementation separately for extraction. -->
    <Copy SourceFiles="$(PublishDir)runtimes/win/lib/net10.0/System.Windows.Extensions.dll" DestinationFiles="$(PublishDir)System.Windows.Extensions.windows.dll" />
    <Copy SourceFiles="$(PkgSystem_Security_Permissions)/THIRD-PARTY-NOTICES.TXT" DestinationFiles="$(PublishDir)Dotnet.Compatibility.NOTICES.LICENSE" />
  </Target>
</Project>

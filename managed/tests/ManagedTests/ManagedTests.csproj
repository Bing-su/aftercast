<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>Aftercast.ManagedTests</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../RecordedActionTranscript.cs" Link="RecordedActionTranscript.cs" />
    <Compile Include="../CombatFixture.cs" Link="CombatFixture.cs" />
    <ProjectReference Include="../../Bridge/Bridge.csproj" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3" GeneratePathProperty="true" PrivateAssets="all" ExcludeAssets="all" />
    <Reference Include="System.Windows.Forms">
      <HintPath>$(PkgMicrosoft_NETFramework_ReferenceAssemblies_net48)/build/.NETFramework/v4.8/System.Windows.Forms.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
  <Target Name="StageHeadlessControls" AfterTargets="Build" Condition="!$([MSBuild]::IsOSPlatform('Windows'))">
    <!-- Tests execute genuine reference signatures against the independently published Linux model. -->
    <Copy SourceFiles="$(MSBuildThisFileDirectory)../../../crates/aftercast-winforms/managed/System.Windows.Forms.dll" DestinationFolder="$(OutDir)" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)../../../crates/aftercast-winforms/managed/System.Windows.Forms.DataVisualization.dll" DestinationFolder="$(OutDir)" />
  </Target>
  <Target Name="StageWindowsRuntime" AfterTargets="Build" Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <!-- Native tests use the same Desktop Runtime contract as a deployed Rust host. -->
    <Copy SourceFiles="$(MSBuildThisFileDirectory)../../../crates/aftercast/managed/Aftercast.Bridge.runtimeconfig.windows.json" DestinationFiles="$(OutDir)$(AssemblyName).runtimeconfig.json" />
  </Target>
</Project>

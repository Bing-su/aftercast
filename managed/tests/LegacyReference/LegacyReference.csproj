<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>Aftercast.LegacyReference</AssemblyName>
    <ActReferencePath Condition="'$(ActReferencePath)' == ''">$(MSBuildThisFileDirectory)../../../binaries/act/Advanced Combat Tracker.exe</ActReferencePath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../CombatFixture.cs" Link="CombatFixture.cs" />
    <Compile Include="../RecordedActionTranscript.cs" Link="RecordedActionTranscript.cs" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3" GeneratePathProperty="true" PrivateAssets="all" ExcludeAssets="all" />
    <Reference Include="System.Windows.Forms">
      <HintPath>$(PkgMicrosoft_NETFramework_ReferenceAssemblies_net48)/build/.NETFramework/v4.8/System.Windows.Forms.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="System.Windows.Forms.DataVisualization">
      <HintPath>$(PkgMicrosoft_NETFramework_ReferenceAssemblies_net48)/build/.NETFramework/v4.8/System.Windows.Forms.DataVisualization.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Bind probes to original metadata; the separate OriginalReference runner also executes them against genuine ACT. -->
    <Reference Include="Advanced Combat Tracker">
      <HintPath>$(ActReferencePath)</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>

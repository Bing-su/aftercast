amends "package://github.com/jdx/hk/releases/download/v2.7.0/hk@2.7.0#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v2.7.0/hk@2.7.0#/Builtins.pkl"
// Using a coding agent? See https://hk.jdx.dev/agents

local linters = new Mapping {
    ["trailing-whitespace"] = Builtins.trailing_whitespace
    ["newlines"] = Builtins.newlines
    ["mixed-line-ending"] = Builtins.mixed_line_ending

    ["oxfmt"] = (Builtins.oxfmt) {
        types = List("json", "yaml", "markdown")
    }
    ["tombi-format"] = Builtins.tombi_format
    ["cargo_fmt"] = (Builtins.cargo_fmt) {
        check =  "cargo fmt --check --manifest-path {{workspace_indicator}} --all"
        check_list_files = "cargo fmt --check --manifest-path {{workspace_indicator}} --all -- --files-with-diff"
        fix = "cargo fmt --manifest-path {{workspace_indicator}} --all"
    }
    ["dx_fmt"] = new Step {
        check = "dx fmt --package aftercast-app --check"
        fix = "dx fmt --package aftercast-app"
        depends = List("cargo_fmt")
    }
}

steps = linters

hooks {
    ["commit-msg"] {
        steps {
            ["conventional"] = Builtins.check_conventional_commit
        }
    }
}
